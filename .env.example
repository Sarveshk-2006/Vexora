# FRAUDOSCOPE — Environment Variable Configuration Template
# IMPORTANT: Copy this file to .env for local development. Never commit real secrets.

# Application Configuration
APP_NAME=FRAUDOSCOPE
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL / Supabase)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=fraudoscope
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/fraudoscope

# Simulation & Determinism Defaults
DEFAULT_RANDOM_SEED=42
SIMULATION_BATCH_SIZE=1000
MAX_EVOLUTION_GENERATIONS=10

# Risk Threshold Defaults
RISK_THRESHOLD_APPROVE=30.0
RISK_THRESHOLD_MONITOR=60.0
RISK_THRESHOLD_STEP_UP=80.0

# LLM / Reasoning Provider (Optional / Placeholder)
# Used for threat scenario ideation and explainability synthesis only
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini
