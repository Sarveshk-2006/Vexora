# VEXORA — Environment Configuration Example

# Environment Mode
ENVIRONMENT=production

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@postgres:5432/fraudoscope

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=vexora_production_secret_key_change_me_in_prod

# CORS Allowed Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://vexora.vercel.app

# Frontend Configurable API Endpoint (Used during Vite build)
VITE_API_URL=http://localhost:8000
